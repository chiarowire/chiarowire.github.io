---
import BaseLayout from './BaseLayout.astro';
import { formatDate, isoDate } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  updated?: string; // YYYY-MM-DD
  noindex?: boolean;
}
const { title, description, updated, noindex } = Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="wrap">
    <h1>{title}</h1>
    {updated && <p class="muted small">Last updated <time datetime={updated}>{formatDate(new Date(updated + 'T00:00:00Z'))}</time></p>}
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
