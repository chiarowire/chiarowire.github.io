---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, CLUSTERS } from '../site.config';
import { getPosts } from '../lib/posts';
import { clusterPath, absUrl } from '../lib/url';

const posts = await getPosts();
const latest = posts.slice(0, SITE.postsPerPageHome);
const counts = Object.fromEntries(CLUSTERS.map((c) => [c.id, posts.filter((p) => p.data.cluster === c.id).length]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: absUrl(),
  description: SITE.description,
  publisher: { '@type': 'Organization', name: SITE.name, url: absUrl(), sameAs: [SITE.youtube.channelUrl] },
};
---
<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap-wide">
      <h1>{SITE.tagline}</h1>
      <p class="lede muted">{SITE.description}</p>
      <p><a class="btn" href={SITE.youtube.subscribeUrl} rel="noopener">Watch on YouTube</a></p>
    </div>
  </section>

  <section class="wrap-wide" aria-labelledby="latest-h">
    <h2 id="latest-h">Latest explainers</h2>
    {latest.length > 0 ? (
      <div class="grid grid-2 grid-3">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="muted">The first explainers are on their way. In the meantime, the videos are on <a href={SITE.youtube.channelUrl} rel="noopener">YouTube</a>.</p>
    )}
  </section>

  <section class="wrap-wide" aria-labelledby="topics-h">
    <h2 id="topics-h">Browse by topic</h2>
    <div class="grid grid-3">
      {CLUSTERS.map((c) => (
        <a class="card topic" href={clusterPath(c.id)}>
          <span class="topic-name">{c.name}</span>
          <span class="muted small">{c.description}</span>
          <span class="small count">{counts[c.id]} {counts[c.id] === 1 ? 'post' : 'posts'}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 2rem 0 1rem; }
  .hero h1 { max-width: 20ch; }
  .lede { font-size: 1.1em; max-width: 38rem; }
  .topic { display: flex; flex-direction: column; gap: 0.35rem; text-decoration: none; color: var(--text); }
  .topic:hover { border-color: var(--accent); }
  .topic-name { font-weight: 700; font-size: 1.1em; color: var(--accent); }
  .count { color: var(--muted); }
</style>
