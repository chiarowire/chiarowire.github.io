---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CLUSTERS } from '../site.config';
import { href, clusterPath } from '../lib/url';
---
<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <div class="wrap">
    <h1>This page took a wrong turn</h1>
    <p>Like a lost packet, the page you wanted didn't make it. It may have moved, or the link may have a typo.</p>
    <p><a class="btn" href={href()}>Go to the home page</a></p>
    <h2>Or browse a topic</h2>
    <ul>
      {CLUSTERS.map((c) => <li><a href={clusterPath(c.id)}>{c.name}</a></li>)}
    </ul>
  </div>
</BaseLayout>
