---
import { SITE, CLUSTERS } from '../site.config';
import { href, clusterPath } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
import { markShapes } from '../lib/logo';
---
<header class="site-header">
  <div class="wrap-wide bar">
    <a class="brand" href={href()}>
      <svg class="logo" aria-hidden="true" viewBox="0 0 64 64" width="34" height="34"><rect width="64" height="64" rx="14" style="fill: var(--accent)"></rect><Fragment set:html={markShapes('currentColor')} /></svg>
      <span class="wordmark">{SITE.name}</span>
    </a>
    <ThemeToggle />
  </div>
  <nav class="wrap-wide nav" aria-label="Topics">
    <ul>
      {CLUSTERS.map((c) => (
        <li><a href={clusterPath(c.id)}>{c.name}</a></li>
      ))}
      <li><a href={href('about/')}>About</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--border); background: var(--surface); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 0.7rem; padding-bottom: 0.3rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 800; font-size: 1.15rem; color: var(--text); text-decoration: none; }
  .logo { width: 2.1rem; height: 2.1rem; flex: none; color: var(--accent-text); }
  .wordmark { letter-spacing: -0.02em; }
  .nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; margin: 0; padding: 0.2rem 0 0.7rem; font-size: 0.9rem; }
  .nav li { margin: 0; }
  .nav a { color: var(--muted); text-decoration: none; font-weight: 600; padding: 0.35rem 0; display: inline-block; }
  .nav a:hover { color: var(--accent); }
</style>
