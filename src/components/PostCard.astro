---
import type { Post } from '../lib/posts';
import { getCluster, formatDate, isoDate } from '../lib/posts';
import { postPath, clusterPath } from '../lib/url';

interface Props {
  post: Post;
  headingLevel?: 2 | 3;
}
const { post, headingLevel = 3 } = Astro.props;
const { title, description, pubDate, cluster, draft } = post.data;
const c = getCluster(cluster);
const H = headingLevel === 2 ? 'h2' : 'h3';
---
<article class="card post-card">
  <p class="meta small">
    <a class="chip" href={clusterPath(c.id)}>{c.name}</a>
    <time datetime={isoDate(pubDate)} class="muted">{formatDate(pubDate)}</time>
    {draft && <span class="chip">Draft</span>}
  </p>
  <H class="title"><a href={postPath(post.id)}>{title}</a></H>
  <p class="desc muted">{description}</p>
</article>

<style>
  .post-card { display: flex; flex-direction: column; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 0 0 0.4rem; }
  .title { font-size: 1.2em; margin: 0.2em 0 0.4em; }
  .title a { color: var(--text); text-decoration: none; }
  .title a:hover { color: var(--accent); text-decoration: underline; }
  .desc { margin: 0; font-size: 0.95em; }
</style>
